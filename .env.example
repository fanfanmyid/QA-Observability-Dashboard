# Dashboard access — password entered on the login screen, and the bearer
# token issued after successful login. Both are REQUIRED; empty values
# disable login entirely (fail-closed).
QA_DASHBOARD_PASSWORD=change-me
CRED_TOKEN=generate-a-long-random-token

# Jenkins integration (pipeline status + test report aggregation).
# Use a Jenkins API token, never your account password.
JENKINS_URL=https://jenkins.example.internal
JENKINS_USER=qa-dashboard-readonly
JENKINS_API_TOKEN=
JENKINS_JOB_BACKEND=study-tracker-backend
JENKINS_JOB_FRONTEND=study-tracker-frontend

# Health probes
FRONTEND_NGINX_EXPORTER_URL=http://frontend-host:9113/metrics
BACKEND_HEALTH_URL=http://backend-host:8000/api/v1/health

# SSH log retrieval (read-only docker logs over SSH).
# Prefer a dedicated low-privilege user in the docker group over root.
SSH_USER=qa-logs
SSH_KEY_PATH=/root/.ssh/id_rsa
BACKEND_SSH_HOST=
FRONTEND_SSH_HOST=
BACKEND_CONTAINER_NAME=study-tracker-backend
FRONTEND_CONTAINER_NAME=study-tracker-frontend
